{
  "name": "@architectured/release-1-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "corepack pnpm --filter @architectured/web exec tsc --noEmit && corepack pnpm --filter @architectured/configuration exec tsc --noEmit",
    "test": "vitest run packages/configuration/src",
    "build": "corepack pnpm --filter @architectured/web build",
    "release-lock:check": "node packages/testing/scripts/check-release-lock.mjs",
    "paths:check": "node packages/testing/scripts/check-paths.mjs",
    "migration:check": "node packages/testing/scripts/check-migration-boundary.mjs",
    "secrets:check": "node packages/testing/scripts/check-secrets.mjs",
    "workflows:format:check": "prettier --config prettier.config.mjs --check ../../.github/workflows/*.yml",
    "rust:format:check": "cargo fmt --all -- --check",
    "rust:check": "cargo check --workspace --locked",
    "ci:check": "corepack pnpm format:check && corepack pnpm workflows:format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm release-lock:check && corepack pnpm paths:check && corepack pnpm migration:check && corepack pnpm secrets:check && corepack pnpm rust:format:check && corepack pnpm rust:check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.9",
    "prettier": "3.9.5",
    "supabase": "2.101.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
