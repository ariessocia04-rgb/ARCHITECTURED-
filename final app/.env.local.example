# Copy this file to ".env.local" and paste your Render PostgreSQL URL.
# Get it from: Render Dashboard → your database → Connections → External Database URL.
# Example value:
# DATABASE_URL=postgres://repair_user:xxxxxxxx@dpg-xxxxx-a.oregon-postgres.render.com/repair_saas
#
# WITHOUT this variable the app runs in offline local mode (data/db.json).
DATABASE_URL=
